#!/bin/sh
# POTACAT desktop pre-push hook: the whole test suite (parallel) runs before
# every push and a failure blocks the push. CI runs the same suite; this finds
# the failure in a minute or two instead of after a 20-minute CI run.
#
# Installed by `node scripts/install-hooks.js` (core.hooksPath = scripts/git-hooks).
#
# Emergencies only: POTACAT_SKIP_PREPUSH=1 git push ...
# skips it. CI still runs everything and a red PR still cannot merge.

if [ "$POTACAT_SKIP_PREPUSH" = "1" ]; then
  echo "[pre-push] POTACAT_SKIP_PREPUSH=1: tests skipped (emergencies only; CI still runs them)"
  exit 0
fi

# Nothing but branch deletions in this push: nothing to test.
zero=0000000000000000000000000000000000000000
run=0
while read -r lref lsha rref rsha; do
  [ "$lsha" != "$zero" ] && run=1
done
[ "$run" = 0 ] && exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1
echo "[pre-push] running the whole test suite (node scripts/run-tests.js) before the push"
if ! node scripts/run-tests.js; then
  echo "[pre-push] tests failed: push blocked. Fix them, or in an emergency only: POTACAT_SKIP_PREPUSH=1 git push"
  exit 1
fi
