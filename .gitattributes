# SSTV style packs are signed by sha256 of their exact bytes. Never let a
# checkout rewrite line endings in them, or the hash depends on who signs.
data/sstv-packs/** -text
# Patches and the sources they add are applied byte-for-byte on every OS.
third_party/ardopcf/potacat-socket-audio.patch -text
third_party/ardopcf/src/** -text
